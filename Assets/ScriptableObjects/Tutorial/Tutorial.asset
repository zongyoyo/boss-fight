  opening:
  - text: "\u55EF\u2026\u2026\u53C8\u4E00\u500B\u8FF7\u8DEF\u95D6\u9032\u68EE\u6797\u6DF1\u8655\u7684\u5192\u96AA\u8005\uFF1F"
    gesture: 2
    saplingGesture: 0
    shot: 0
    after: 0
    cueShot: 0
  - text: "\u770B\u4F60\u9023\u76FE\u90FD\u62FF\u4E0D\u7A69\u7684\u6A23\u5B50\u2026\u2026\u597D\u5566\uFF0C\u672C\u5C0F\u82B1\u5C31\u5927\u767C\u6148\u60B2\u6559\u4F60\u5E7E\u62DB\u3002"
    gesture: 3
    saplingGesture: 0
    shot: 1
    after: 1
    cueShot: 3
  - text: "\u4F86\uFF0C\u9019\u96BB\u5C0F\u6A39\u7CBE\u501F\u4F60\u7576\u7DF4\u7FD2\u9776\u3002\u5225\u5BA2\u6C23\uFF0C\u5B83\u5F88\u8010\u6253\u7684\u3002"
    gesture: 5
    saplingGesture: 0
    shot: 0
    after: 0
    cueShot: 0
  steps:
  - {fileID: 11400000, guid: 069381724ba30b44099f329145f994db, type: 2}
