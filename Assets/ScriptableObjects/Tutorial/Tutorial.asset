  ending:
  - text: "\u4E0D\u932F\u561B\uFF0C\u4F60\u5DF2\u7D93\u662F\u500B\u5408\u683C\u7684\u5192\u96AA\u8005\u4E86\u3002"
    gesture: 6
    saplingGesture: 0
    shot: 0
    after: 0
    cueShot: 0
  - text: "\u5C0D\u4E86\uFF0C\u9019\u7247\u68EE\u6797\u7684\u4E3B\u4EBA\u662F\u4E00\u68F5\u5927\u6A39\u5B88\u885B\u3002\u6709\u672C\u4E8B\u7684\u8A71\uFF0C\u53BB\u6311\u6230\u770B\u770B\u5427\uFF1F"
    gesture: 10
    saplingGesture: 0
    shot: 2
    after: 0
    cueShot: 0
  - text: "\u9806\u5E36\u4E00\u63D0\u2026\u2026\u4F60\u525B\u525B\u6253\u5012\u7684\u90A3\u96BB\u5C0F\u6A39\u7CBE\uFF0C\u5C31\u662F\u5927\u6A39\u5B88\u885B\u7684\u5C0F\u5B69\u5594\u3002\u563B\u563B\u3002"
