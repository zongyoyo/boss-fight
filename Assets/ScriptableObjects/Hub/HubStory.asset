  chiefName: "\u6751\u9577"
  introLines:
  - "\u5594\u5594\uFF0C\u4F60\u5C31\u662F\u65B0\u4F86\u7684\u5192\u96AA\u8005\u5427\uFF1F\u4F86\u5F97\u6B63\u597D\u3002"
  - "\u6700\u8FD1\u68EE\u6797\u6DF1\u8655\u51FA\u73FE\u4E86\u4E00\u96BB\u602A\u8C93\uFF0C\u6574\u5929\u4E00\u908A\u5531\u6B4C\u4E00\u908A\u539F\u5730\u8F49\u5708\u3002"
  - "\u7260\u8F49\u5F97\u8D8A\u5FEB\uFF0C\u68EE\u6797\u88E1\u7684\u96F7\u96E8\u5C31\u8D8A\u5927\uFF0C\u9023\u6A39\u90FD\u5FEB\u88AB\u5439\u5012\u4E86\u3002"
  - "\u6751\u5B50\u88E1\u6C92\u4EBA\u6562\u9760\u8FD1\u7260\u2026\u2026\u80FD\u8ACB\u4F60\u5E6B\u5E6B\u5FD9\u55CE\uFF1F"
  - "\u6E96\u5099\u597D\u4E86\u5C31\u5230\u5C0F\u5C4B\u524D\u627E\u6211\uFF0C\u6211\u518D\u8DDF\u4F60\u8AAA\u8A73\u7D30\u7684\u3002"
  introDelay: 0.6
  walkSpeed: 3.5
  turnSpeed: 540
  idleLines:
  - "\u591A\u8667\u4E86\u4F60\uFF0C\u68EE\u6797\u6700\u8FD1\u5B89\u975C\u591A\u4E86\u3002"
  questAcceptedFormat: "\u300C{0}\u300D\u5C31\u62DC\u8A17\u4F60\u4E86\uFF0C\u8DEF\u4E0A\u5C0F\u5FC3\uFF01"
