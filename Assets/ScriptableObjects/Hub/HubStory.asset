  m_Script: {fileID: 11500000, guid: 3fe53f133cc53494fb258b99fca85a4e, type: 3}
  m_Name: HubStory
  m_EditorClassIdentifier: Assembly-CSharp::BossFight.Hub.HubStoryData
  chiefName: "\u6751\u9577"
  introLines:
  - "\u5594\u5594\uFF0C\u4F60\u5C31\u662F\u65B0\u4F86\u7684\u5192\u96AA\u8005\u5427\uFF1F\u4F86\u5F97\u6B63\u597D\u3002"
  - "\u6751\u5B50\u6700\u8FD1\u88AB\u4E00\u96BB\u602A\u8C93\u641E\u5F97\u96DE\u72AC\u4E0D\u5BE7\uFF0C\u6211\u8DDF\u4F60\u8AAA\u8AAA\u90A3\u96BB\u8C93\u7684\u4E8B\u5427\u3002"
  introDelay: 0.6
  knockdownLines:
  - "\u5594\uFF0C\u4F60\u9192\u5566\u3002\u6628\u5929\u508D\u665A\u5728\u68EE\u6797\u908A\u64BF\u5230\u4F60\uFF0C\u6574\u500B\u4EBA\u5012\u5728\u6A39\u6839\u5806\u88E1\u3002"
  - "\u770B\u4F60\u9019\u4E00\u8EAB\u50B7\u2026\u2026\u8A72\u4E0D\u6703\u662F\u53BB\u60F9\u4E86\u5927\u6A39\u5B88\u885B\u5427\uFF1F\u4EE5\u4F60\u73FE\u5728\u7684\u672C\u4E8B\uFF0C\u9084\u6253\u4E0D\u904E\u90A3\u50A2\u4F19\u7684\u3002"
  - "\u5148\u5728\u9644\u8FD1\u7D2F\u7A4D\u9EDE\u5BE6\u529B\u5427\u3002\u6700\u8FD1\u68EE\u6797\u88E1\u5192\u51FA\u4E00\u96BB\u6703\u8F49\u5708\u7684\u602A\u8C93\uFF0C\u6B63\u597D\u62FF\u7260\u4F86\u7DF4\u7DF4\u624B\u3002"
  - "\u6211\u8DDF\u4F60\u8AAA\u8AAA\u90A3\u96BB\u8C93\u7684\u4E8B\u5427\u3002"
  victoryLines:
  - "\u5594\uFF0C\u4F60\u56DE\u4F86\u5566\u3002\u525B\u624D\u68EE\u6797\u6DF1\u8655\u90A3\u9663\u5730\u9CF4\u2026\u2026\u8A72\u4E0D\u6703\u662F\u4F60\u641E\u51FA\u4F86\u7684\u5427\uFF1F"
  - "\u9023\u5927\u6A39\u5B88\u885B\u90FD\u6514\u4E0D\u4F4F\u4F60\uFF0C\u771F\u4E86\u4E0D\u8D77\u3002"
  - "\u4E0D\u904E\u6700\u8FD1\u68EE\u6797\u88E1\u53C8\u5192\u51FA\u4E00\u96BB\u6703\u8F49\u5708\u7684\u602A\u8C93\uFF0C\u9084\u5F97\u9EBB\u7169\u4F60\u8D70\u4E00\u8D9F\u3002"
  - "\u6211\u8DDF\u4F60\u8AAA\u8AAA\u90A3\u96BB\u8C93\u7684\u4E8B\u5427\u3002"
  walkSpeed: 3.5
  turnSpeed: 540
  greetRadius: 6
  idleLines:
  - "\u591A\u8667\u4E86\u4F60\uFF0C\u68EE\u6797\u6700\u8FD1\u5B89\u975C\u591A\u4E86\u3002"
  questAcceptedFormat: "\u300C{0}\u300D\u5C31\u62DC\u8A17\u4F60\u4E86\u3002"
  declineLines:
  - "\u597D\u5427\uFF0C\u7B49\u4F60\u6E96\u5099\u597D\u4E86\uFF0C\u518D\u4F86\u5C0F\u5C4B\u524D\u627E\u6211\u3002"
  rewardLineFormat: "\uFF08\u7372\u5F97\uFF1A{0}\uFF09"
  rewardSeparator: "\u3001"
  skillPointsFormat: "\u6280\u80FD\u9EDE \xD7{0}"
