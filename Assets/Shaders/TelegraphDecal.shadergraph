{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "3000000000000000000000000000000c",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "TelegraphShape (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -450.0,
            "y": 200.0,
            "width": 260.0,
            "height": 200.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "41000000000000000000000000000000"
        },
        {
            "m_Id": "41000000000000000000000000000001"
        },
        {
            "m_Id": "41000000000000000000000000000002"
        },
        {
            "m_Id": "41000000000000000000000000000003"
        },
        {
            "m_Id": "41000000000000000000000000000004"
        },
        {
            "m_Id": "41000000000000000000000000000005"
        },
        {
            "m_Id": "41000000000000000000000000000006"
        },
        {
            "m_Id": "41000000000000000000000000000007"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "TelegraphShape",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Params: x 形狀（0 圓／環、1 長方形）、y 填色進度 0..1、z 環的內半徑比例、w 閃光 0..1\n// Style: x 外框寬 (m)、y 填色透明度、z 範圍底色透明度、w 發光強度\n// Size: xy 投影範圍 (m)；圓形以 x 為直徑。長方形的填色沿 V（投影器的 +Y）長出去\nfloat shape = Params.x;\nfloat fill = saturate(Params.y);\nfloat inner = saturate(Params.z);\nfloat flash = saturate(Params.w);\nfloat edge = max(Style.x, 0.001);\nfloat2 size = max(Size.xy, float2(0.001, 0.001));\nfloat aa = 0.04;\nfloat inside;\nfloat edgeMask;\nfloat filled;\nfloat front;\nif (shape < 0.5)\n{\n    float radius = size.x * 0.5;\n    float r = length(UV - 0.5) * size.x;\n    float innerR = inner * radius;\n    inside = (1.0 - smoothstep(radius - aa, radius, r)) * (innerR > 0.0 ? smoothstep(innerR - aa, innerR, r) : 1.0);\n    float outerEdge = smoothstep(radius - edge - aa, radius - edge, r);\n    float innerEdge = innerR > 0.0 ? 1.0 - smoothstep(innerR + edge, innerR + edge + aa, r) : 0.0;\n    edgeMask = saturate(outerEdge + innerEdge) * inside;\n    float fillR = lerp(innerR, radius, fill);\n    filled = (1.0 - smoothstep(fillR - aa, fillR, r)) * inside * step(0.001, fill);\n    front = smoothstep(fillR - edge - aa, fillR - edge, r) * filled;\n}\nelse\n{\n    float2 p = UV * size;\n    float dx = min(p.x, size.x - p.x);\n    float dy = min(p.y, size.y - p.y);\n    inside = smoothstep(0.0, aa, dx) * smoothstep(0.0, aa, dy);\n    edgeMask = (1.0 - smoothstep(edge, edge + aa, min(dx, dy))) * inside;\n    float fy = fill * size.y;\n    filled = (1.0 - smoothstep(fy - aa, fy, p.y)) * inside * step(0.001, fill);\n    front = smoothstep(fy - edge - aa, fy - edge, p.y) * filled;\n}\nfloat a = max(max(edgeMask, front), max(filled * Style.y, inside * Style.z));\na = lerp(a, inside, flash);\nAlpha = saturate(a * Tint.a);\nfloat3 col = lerp(Tint.rgb, float3(1.0, 1.0, 1.0), flash * 0.6);\nBaseColor = saturate(col);\nEmission = col * Style.w * (1.0 + flash * 2.0) * Alpha;"
}

